{
  "name": "proxy-scout",
  "version": "0.1.0",
  "description": "A lightweight CLI and library for checking HTTP/HTTPS proxy health, latency, and exit IP.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "proxy-scout": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "proxy",
    "proxy-checker",
    "http-proxy",
    "https-proxy",
    "scraping",
    "web-scraping",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
